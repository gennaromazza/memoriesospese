modules = ["nodejs-22", "web", "postgresql-16", "python-3.11"]
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["killall"]

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm run build"]
run = ["sh", "-c", "NODE_ENV=production node dist/index.js"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Dev Workflow"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node patches/fix-radix-compose-refs.cjs && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Dev Workflow"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8976
externalPort = 3001

[[ports]]
localPort = 24678
externalPort = 3000

[agent]
integrations = ["google-mail:1.0.0", "google-drive:1.0.0"]

[userenv]

[userenv.shared]
SITE_URL = "https://imagestudiofotografico.com"
GOOGLE_CALENDAR_ID = "gennaro.mazzacane@gmail.com"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
