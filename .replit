modules = ["nodejs-20", "web", "postgresql-16"]
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

# 🔥 Un solo comando DEV
run = "npm run dev"

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"

# 🔥 Build pulita, ZERO doppie installazioni
build = ["sh", "-c", "npm ci && npm run build"]

# 🔥 Start pulito
run = ["sh", "-c", "node dist/index.js"]

[workflows]
runButton = "Prod Build & Start"

# ========== DEV WORKFLOW ==========
[[workflows.workflow]]
name = "Dev Workflow"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm ci"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5173


# ========== PROD WORKFLOW ==========
[[workflows.workflow]]
name = "Prod Build & Start"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm ci"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run build"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node dist/index.js"


# ========== RIMOSSO WORKFLOW “Genny” ==========
# Non serviva, creava conflitti enormi.


# ========== PORTE NECESSARIE ==========
# In realtà te ne serve una sola: quella di Vite
[[ports]]
localPort = 5173
externalPort = 5173
