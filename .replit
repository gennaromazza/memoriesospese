modules = ["nodejs-20", "web", "postgresql-16"]
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["killall"]

[deployment]
deploymentTarget = "autoscale"
# Usa npm install (ci richiede package-lock)
build = ["sh", "-c", "npm install --force && npm run build"]
run = ["sh", "-c", "node dist/index.js"]

[workflows]
runButton = "Dev Workflow"

[[workflows.workflow]]
name = "Dev Workflow"
mode = "sequential"
author = "agent"

# STEP 1 — install dipendenze
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install --force"

# STEP 2 — avvio dev server
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"

[[workflows.workflow]]
name = "Prod Build & Start"
mode = "sequential"
author = "agent"

# STEP 1 — install prod
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install --force"

# STEP 2 — build prod
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run build"

# STEP 3 — start
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node dist/index.js"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8039
externalPort = 3002

[[ports]]
localPort = 8057
externalPort = 3003

[[ports]]
localPort = 8644
externalPort = 4200

[[ports]]
localPort = 24678
externalPort = 3001

[[ports]]
localPort = 33503
externalPort = 3000

[agent]
integrations = ["google-mail:1.0.0", "google-drive:1.0.0"]
