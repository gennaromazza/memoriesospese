modules = ["nodejs-20", "web", "postgresql-16"]
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

run = "npm run dev"

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm ci && npm run build"]
run = ["sh", "-c", "node dist/index.js"]

[workflows]
runButton = "Dev Workflow"

[[workflows.workflow]]
name = "Dev Workflow"
mode = "sequential"
author = "agent"

# STEP 1 – Install veloci con cache
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm ci || npm install"

# STEP 2 – Avvio Vite (porta corretta!)
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5173

# PROD WORKFLOW
[[workflows.workflow]]
name = "Prod Build & Start"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm ci"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run build"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node dist/index.js"

# PORTE
[[ports]]
localPort = 5173
externalPort = 5173
