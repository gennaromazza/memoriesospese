modules = ["nodejs-20", "web", "postgresql-16"]
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

# Comando usato dal pulsante "Run" in Replit
run = "npm run dev"

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm ci && npm run build"]
run = ["sh", "-c", "node dist/index.js"]

[workflows]
runButton = "Dev Workflow"

###############################################
# 🛠️ DEV WORKFLOW — Avvio veloce senza reinstallare
###############################################

[[workflows.workflow]]
name = "Dev Workflow"
mode = "sequential"
author = "agent"

# STEP 1 – Install solo se node_modules non esiste
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "if [ ! -d node_modules ]; then npm install; fi"

# STEP 2 – Avvio Vite
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5173


###############################################
# 🚀 PROD WORKFLOW — Build e avvio server
###############################################

[[workflows.workflow]]
name = "Prod Build & Start"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm ci"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run build"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node dist/index.js"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 24678
externalPort = 3001

[[ports]]
localPort = 43041
externalPort = 3000
