modules = ["nodejs-20", "web", "postgresql-16"]
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["killall"]

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm ci && npm run build"]
run = ["sh", "-c", "node dist/index.js"]

[workflows]
runButton = "Dev Workflow"

[[workflows.workflow]]
name = "Dev Workflow"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm ci"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"

[[workflows.workflow]]
name = "Prod Build & Start"
mode = "sequential"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm ci"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run build"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node dist/index.js"

# --- CONFIGURAZIONE PORTE CORRETTA ---

# Questa è la tua porta principale (Express + Vite Middleware)
# Mappiamo la porta interna 5000 sulla porta esterna 80 (Web)
[[ports]]
localPort = 5000
externalPort = 80
