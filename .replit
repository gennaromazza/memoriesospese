modules = ["nodejs-20", "web", "postgresql-16"]
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["killall"]

[deployment]
deploymentTarget = "autoscale"
# Build and serving commands are defined per service in
# artifacts/*/.replit-artifact/artifact.toml (pnpm workspace).

[workflows]
runButton = "Dev Workflow"

[[workflows.workflow]]
name = "Dev Workflow"
mode = "sequential"
author = "agent"

# STEP 1 — install dipendenze
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install --force"

# STEP 2 — avvio dev server
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"

[[workflows.workflow]]
name = "Prod Build & Start"
mode = "sequential"
author = "agent"

# STEP 1 — install prod
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install --force"

# STEP 2 — build prod
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run build"

# STEP 3 — start
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node dist/index.js"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8039
externalPort = 3002

[[ports]]
localPort = 8057
externalPort = 3003

[[ports]]
localPort = 23768
externalPort = 3000

[[ports]]
localPort = 24678
externalPort = 3001
