rules_version = '2';

// Firebase Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'gennaro.mazzacane@gmail.com';
    }

    function printOrder(orderId) {
      return firestore.get(
        /databases/(default)/documents/orders/$(orderId)
      ).data;
    }

    function printAsset(orderId, assetId) {
      return firestore.get(
        /databases/(default)/documents/orders/$(orderId)/assets/$(assetId)
      ).data;
    }
    
    function isValidImageFile() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < 10 * 1024 * 1024; // 10MB limit
    }
    
    function isValidAudioFile() {
      return request.resource.contentType.matches('audio/.*') &&
             request.resource.size < 50 * 1024 * 1024; // 50MB limit
    }
    
    // Gallery photos - uploaded by admin or guests
    match /galleries/{galleryId}/{allPaths=**} {
      allow read: if true; // Public read for gallery access
      allow write: if isSignedIn() && isValidImageFile();
    }

    // Gallery thumbnails - miniature leggere generate lato server (admin SDK).
    // Percorso separato da galleries/ per non essere indicizzato dai tool di recovery/sync.
    match /thumbnails/{galleryId}/{allPaths=**} {
      allow read: if true; // Public read per la griglia galleria
      allow write: if isSignedIn() && isValidImageFile();
    }
    
    // Global photos collection
    match /photos/{photoId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidImageFile();
    }
    
    // Voice memos - audio files (nested path: voice-memos/{galleryId}/{fileName})
    match /voice-memos/{galleryId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isValidAudioFile();
    }
    
    // User profile pictures  
    match /profile-pictures/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidImageFile();
    }
    
    // Watermarks - only for the owning user or admin
    match /watermarks/{fileName} {
      allow read: if isSignedIn() || isAdmin();
      allow write: if isSignedIn() && isValidImageFile();
      allow delete: if isSignedIn() || isAdmin();
    }
    
    // Admin uploads and assets
    match /admin/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Slideshow images
    match /slideshow/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Blog content - large HTML posts stored externally
    match /blog-content/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Blog cover images - admin only write, public read
    match /blog-covers/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImageFile();
      allow delete: if isAdmin();
    }

    // Immagini inserite nell'editor Blog
    match /blog-article-images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImageFile();
      allow delete: if isAdmin();
    }

    // Immagini importate da WordPress (upload via Admin SDK, cleanup dal pannello)
    match /blog-images/{allPaths=**} {
      allow read: if true;
      allow delete: if isAdmin();
    }
    
    // Portfolio direct uploads - admin only write, public read
    match /portfolio-direct/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImageFile();
      allow delete: if isAdmin();
    }
    
    // Product catalog images - admin write, public read
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImageFile();
      allow delete: if isAdmin();
    }

    // Originali dello shop stampe: privati, intestati all'utente e solo JPEG.
    // La cancellazione e ogni modifica passano dal backend, che verifica anche
    // lo stato dell'ordine prima di usare l'Admin SDK.
    match /print-orders/{userId}/{orderId}/{assetId}/original.jpg {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if resource == null &&
        isOwner(userId) &&
        printOrder(orderId).orderType == 'print_shop' &&
        printOrder(orderId).ownerUid == userId &&
        printOrder(orderId).payment.status != 'paid' &&
        printOrder(orderId).fulfillment.status in ['draft', 'awaiting_payment'] &&
        printAsset(orderId, assetId).status == 'prepared' &&
        printAsset(orderId, assetId).ownerUid == userId &&
        printAsset(orderId, assetId).orderId == orderId &&
        printAsset(orderId, assetId).storagePath ==
          'print-orders/' + userId + '/' + orderId + '/' + assetId + '/original.jpg' &&
        request.resource.contentType == 'image/jpeg' &&
        request.resource.size > 0 &&
        request.resource.size <= 50 * 1024 * 1024 &&
        request.resource.metadata.ownerUid == userId &&
        request.resource.metadata.orderId == orderId &&
        request.resource.metadata.assetId == assetId;
      allow update, delete: if false;
    }

    // Job note photos (note per foto allegate ai Jobs) - solo admin
    match /jobs/{jobId}/note-foto/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin() && isValidImageFile();
      allow delete: if isAdmin();
    }

    // Temporary uploads cleanup
    match /temp/{allPaths=**} {
      allow read, write: if isSignedIn() && 
        request.resource.size < 20 * 1024 * 1024; // 20MB temp limit
    }
    
    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
