rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
        (request.auth.token.email == 'gennaro.mazzacane@gmail.com' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Subscriptions collection - Email notifications for new photos
    match /subscriptions/{subscriptionId} {
      allow read: if true; // Lettura pubblica necessaria per server Express (invio notifiche email)
      allow create: if 
        // Permetti iscrizione con autenticazione (anche anonima) e validazione campi richiesti
        isSignedIn() &&
        request.resource.data.keys().hasAll(['galleryId', 'galleryName', 'email', 'active', 'subscribedAt']) &&
        request.resource.data.email is string &&
        request.resource.data.email.matches('.*@.*') && // Validazione email base
        request.resource.data.galleryId is string &&
        request.resource.data.galleryName is string &&
        request.resource.data.active == true &&
        request.resource.data.subscribedAt is timestamp;
      allow update: if isAdmin(); // Solo admin può modificare
      allow delete: if isAdmin(); // Solo admin può eliminare
    }

    // Gallery Secrets - Collection separata SOLO per password/PIN (admin/server-only access)
    match /gallerySecrets/{galleryId} {
      allow read: if isAdmin(); // Solo admin può leggere password/PIN
      allow write: if isAdmin(); // Solo admin può modificare password/PIN
    }

    // Galleries collection
    match /galleries/{galleryId} {
      // SICUREZZA: password e specialPin RIMOSSI da questo documento
      // Ora salvati in collection separata `gallerySecrets` con accesso admin-only
      // Questo documento contiene solo dati pubblici (nome, data, hasPassword flag, etc.)
      allow read: if true; // Lettura pubblica sicura (no password in chiaro)
      allow create: if isSignedIn();
      allow update: if 
        // Admin o proprietario può modificare tutto
        (isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin())) ||
        // Utenti anonimi possono aggiornare SOLO selezione foto quando abilitata
        (resource.data.selectionEnabled == true && 
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['selectedPhotoIds', 'photoAssignments', 'selectionStatus', 'selectionNotes', 'updatedAt']));
      allow delete: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || isAdmin());

      // Gallery subcollections (legacy support)  
      match /photos/{photoId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && 
          (resource.data.uploaderEmail == request.auth.token.email || 
           resource.data.uploaderUid == request.auth.uid || isAdmin());
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && 
          (resource.data.userId == request.auth.uid || isAdmin());
      }

      match /voiceMemos/{memoId} {
        allow read: if true;
        allow create: if true; // Allow anonymous voice memo creation
        allow update, delete: if isSignedIn() && 
          (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // Global photos collection
    match /photos/{photoId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && 
        (resource.data.uploaderEmail == request.auth.token.email || isAdmin());
      allow delete: if isSignedIn() && 
        (resource.data.uploaderEmail == request.auth.token.email || isAdmin());
    }

    // Comments collection
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Voice memos collection (global)
    match /voiceMemos/{memoId} {
      allow read: if true;
      allow create: if true; // Allow anonymous voice memo creation
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Likes collection
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Email notifications collection
    match /email-notifications/{notificationId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && 
        request.resource.data.keys().hasAll(['email', 'galleryId']) &&
        request.resource.data.email is string &&
        request.resource.data.galleryId is string;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Gallery access collection
    match /gallery-access/{accessId} {
      allow read: if isAdmin();
      allow create: if true; // Public can request access
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Password requests collection - Richieste password pubbliche
    match /passwordRequests/{requestId} {
      allow read: if isAdmin();
      allow create: if true; // Chiunque può richiedere la password
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Studio settings (legacy)
    match /studio-settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings collection (new structure)
    match /settings/{documentId} {
      allow read: if true; // Ospiti possono leggere le informazioni dello studio
      allow write: if isAdmin(); // Solo admin può modificare le impostazioni
    }

    // ====== QUESTIONARIO SYSTEM RULES ======

    // FAQ Sets - Con regole per inizializzazione automatica
    match /faqSets/{faqSetId} {
      allow read: if true; // Lettura pubblica per disponibilità set
      allow write: if isAdmin();
      allow create: if isAdmin() || 
        (request.resource.data.createdBy == 'system' && 
         request.resource.data.version == 1); // Permetti creazione set sistema v1
    }

    // Questionnaire Tokens - Permetti lettura pubblica per validazione, admin per gestione
    match /questionnaireTokens/{tokenId} {
      allow read: if true; // Lettura pubblica per validazione token
      allow write: if isAdmin(); // Solo admin può creare/modificare/eliminare token
    }

    // ===== Validation Sessions =====
    match /validationSessions/{sessionId} {
      allow read: if true;
      allow create: if true;
      allow update: if true; // Permetti aggiornamento per usedAt
      allow delete: if isAdmin();
    }

    // Rate Limits - Permetti accesso pubblico per controllo rate limiting
    match /rateLimits/{identifier} {
      allow read: if true; // Lettura pubblica per verifica rate limits
      allow create, update: if true; // Creazione/aggiornamento pubblico per conteggi
      allow delete: if isAdmin(); // Solo admin può eliminare rate limits
    }

    // Distributed Locks - Per prevenire race conditions nelle operazioni atomiche
    match /distributedLocks/{lockId} {
      allow read: if true; // Lettura pubblica per verifica lock esistenti
      allow create, update: if true; // Creazione/aggiornamento pubblico per acquisizione lock
      allow delete: if true; // Eliminazione pubblica per rilascio lock e cleanup
    }

    // Helper function for role validation
    function isValidRole(role) {
      return role == 'bride' || role == 'groom';
    }

    // Helper function for questionnaire token validation
    function hasValidToken(galleryId, role, token) {
      // This will be validated via Cloud Function in production
      // For now, allow if token is present and role is valid
      return true; // Placeholder, replace with actual token validation logic
    }

    // ===== Questionnaires =====
    match /galleries/{galleryId}/questionnaires/{questionnaireId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();

      // Risposte definitive
      match /answers/{role} {
        allow read: if true; // Permetti lettura libera per debugging
        allow write: if
          isValidRole(role) &&
          (isAdmin() || 
           (request.query.token != null && hasValidToken(galleryId, role, request.query.token)));
      }

      // Bozze risposte
      match /drafts/{role} {
        allow read: if true; // Permetti lettura libera per debugging  
        allow write: if
          isValidRole(role) &&
          (isAdmin() ||
           (request.query.token != null && hasValidToken(galleryId, role, request.query.token)));
      }
    }

    // Public access to active FAQ questions (read-only, minimal data)
    match /faqSets/{faqSetId} {
      // Allow public read of active FAQ set questions only
      allow read: if resource.data.active == true && 
        request.auth != null &&
        // Limit to questions field only
        request.query.select == ['questions'];
    }

    // ====== COUPLE STORIES SYSTEM RULES ======
    
    // Couple Stories collection - Admin only creation/modification, public read access for gallery viewing
    match /coupleStories/{galleryId} {
      allow read: if true; // Public read access for story viewing in galleries
      allow create: if isAdmin(); // Only admin can create new stories
      allow update: if isAdmin(); // Only admin can update existing stories
      allow delete: if isAdmin(); // Only admin can delete stories
    }

    // ====== SLIDESHOW IMAGES RULES ======
    
    // Slideshow images collection - Admin only management, public read access
    match /slideshow/{imageId} {
      allow read: if true; // Public read access for homepage slideshow
      allow create: if isAdmin(); // Only admin can add slideshow images
      allow update: if isAdmin(); // Only admin can update slideshow images
      allow delete: if isAdmin(); // Only admin can delete slideshow images
    }

    // ====== BOOKING SYSTEM RULES (November 2025) ======
    
    // Products - Admin-only management, public read for booking form
    match /products/{productId} {
      allow read: if true; // Public read access for booking forms
      allow create: if isAdmin(); // Only admin can create products
      allow update: if isAdmin(); // Only admin can update products
      allow delete: if isAdmin(); // Only admin can delete products
    }
    
    // Booking Campaigns - Admin-only management, public read for active campaigns
    match /booking_campaigns/{campaignId} {
      allow read: if true; // Public read access for active booking campaigns
      allow create: if isAdmin(); // Only admin can create campaigns
      allow update: if isAdmin(); // Only admin can update campaigns
      allow delete: if isAdmin(); // Only admin can delete campaigns
    }
    
    // Bookings - Public can create, admin manages
    match /bookings/{bookingId} {
      allow read: if isAdmin(); // Only admin can see all bookings
      allow create: if true; // Public can create bookings via booking form
      allow update: if isAdmin(); // Only admin can update bookings (confirm, complete, etc.)
      allow delete: if isAdmin(); // Only admin can delete bookings
    }
    
    // Orders - Admin-only management
    match /orders/{orderId} {
      allow read: if isAdmin(); // Only admin can see orders
      allow create: if isAdmin(); // Only admin can create orders
      allow update: if isAdmin(); // Only admin can update orders (payment tracking)
      allow delete: if isAdmin(); // Only admin can delete orders
    }
    
    // Clienti - Admin-only client management (November 2025)
    match /clienti/{clienteId} {
      allow read: if isAdmin(); // Only admin can see clients (sensitive data: emails, phones, addresses)
      allow create: if isAdmin(); // Only admin can create clients
      allow update: if isAdmin(); // Only admin can update clients
      allow delete: if isAdmin(); // Only admin can delete clients
    }
    
    // Cash Movements - Admin-only financial management (November 2025)
    match /cashMovements/{movementId} {
      allow read: if isAdmin(); // Only admin can view cash movements
      allow create: if isAdmin(); // Only admin can create cash movements
      allow update: if isAdmin(); // Only admin can update cash movements
      allow delete: if isAdmin(); // Only admin can delete cash movements
    }
    
    // Photo Selections - Guest users can select photos, admin can read all
    match /photo_selections/{selectionId} {
      allow read: if true; // Public read access for guests to see their selections
      allow create: if true && // Allow guest selection with validation
        request.resource.data.keys().hasAll(['galleryId', 'photoId', 'photoName', 'photoUrl', 'selectedAt']) &&
        request.resource.data.galleryId is string &&
        request.resource.data.photoId is string &&
        request.resource.data.photoName is string &&
        request.resource.data.photoUrl is string &&
        request.resource.data.selectedAt is timestamp;
      allow update: if isAdmin(); // Only admin can update selections
      allow delete: if true; // Allow guest to deselect photos (public delete)
    }
    
    // Photo Selections (camelCase variant) - Same rules as photo_selections for backward compatibility
    match /photoSelections/{selectionId} {
      allow read: if true; // Public read access for guests and admin
      allow create: if true && // Allow guest selection with validation
        request.resource.data.keys().hasAll(['galleryId', 'photoId', 'selectedAt']) &&
        request.resource.data.galleryId is string &&
        request.resource.data.photoId is string &&
        request.resource.data.selectedAt is timestamp;
      allow update: if isAdmin(); // Only admin can update selections
      allow delete: if true; // Allow guest to deselect photos (public delete)
    }
    
    // ====== JOB TYPES & QUOTES SYSTEM RULES (November 2025) ======
    
    // Job Types - Dynamic configurable job types (matrimoni, battesimi, etc.)
    match /jobTypes/{jobTypeId} {
      allow read: if true; // Public read access (needed for public consultation booking page)
      allow create: if isAdmin(); // Only admin can create new job types
      allow update: if isAdmin(); // Only admin can update job types
      allow delete: if isAdmin(); // Only admin can delete job types
    }
    
    // Job Provenances - Dynamic configurable job provenances (instagram, passaparola, etc.)
    match /jobProvenances/{provenanceId} {
      allow read: if isSignedIn(); // Authenticated users can read job provenances (needed for jobs UI)
      allow create: if isAdmin(); // Only admin can create new job provenances
      allow update: if isAdmin(); // Only admin can update job provenances
      allow delete: if isAdmin(); // Only admin can delete job provenances
    }
    
    // Product Categories - Dynamic configurable product categories (album, stampe, etc.)
    match /productCategories/{categoryId} {
      allow read: if true; // Public read access (needed for products UI and category dropdowns)
      allow create: if isAdmin(); // Only admin can create new product categories
      allow update: if isAdmin(); // Only admin can update product categories
      allow delete: if isAdmin(); // Only admin can delete product categories
    }
    
    // Contract Clauses - Template clauses for contracts
    match /contractClauses/{clauseId} {
      allow read: if true; // Public read access for clauses (template data, similar to quotes)
      allow create: if isAdmin(); // Only admin can create new clauses
      allow update: if isAdmin(); // Only admin can update clauses
      allow delete: if isAdmin(); // Only admin can delete clauses
    }
    
    // Quote Templates - Reusable quote templates for different job types
    match /quoteTemplates/{templateId} {
      allow read: if true; // Public read access for templates (template data, similar to quotes)
      allow create: if isAdmin(); // Only admin can create new templates
      allow update: if isAdmin(); // Only admin can update templates
      allow delete: if isAdmin(); // Only admin can delete templates
    }
    
    // Jobs - Client jobs/commissions with quotes (updated November 2025 for multi-client support)
    match /jobs/{jobId} {
      allow read: if isAdmin() || 
        (isSignedIn() && resource.data.clientiIds.hasAny([request.auth.uid])); // Admin or any linked client can read
      allow create: if isAdmin(); // Only admin can create jobs
      allow update: if isAdmin(); // Only admin can update jobs
      allow delete: if isAdmin(); // Only admin can delete jobs
    }
    
    // Quotes - Top-level collection for quotes (linked to jobs via jobId field)
    match /quotes/{quoteId} {
      allow read: if true; // Public read with token validation in app layer (publicToken)
      allow create: if isAdmin(); // Only admin can create quotes
      allow update: if true; // Allow client-side signature updates (signature, selectedProducts, totaleSelezionato)
      allow delete: if isAdmin(); // Only admin can delete quotes
    }
    
    // Quote Audit Log - Complete history of manual status changes and signature overrides (November 2025)
    match /quoteAuditLog/{eventId} {
      allow read: if isAdmin(); // Only admin can view audit trail (contains sensitive admin operations)
      allow create: if isAdmin(); // Only admin can create audit events (via manual status changes)
      allow update: if false; // Audit events are immutable once created
      allow delete: if false; // Audit events cannot be deleted (compliance & traceability)
    }
    
    // Job Timeline - Event log/history for jobs (November 2025)
    match /jobTimeline/{eventId} {
      allow read: if isAdmin(); // Admin can read all timeline events
      allow create: if isAdmin(); // Only admin can create timeline events (automated via createJob, updateJobStatus, etc.)
      allow update: if isAdmin(); // Only admin can update timeline events
      allow delete: if isAdmin(); // Only admin can delete timeline events
    }
    
    // Payment Schedules - Payment tracking for jobs (November 2025)
    match /paymentSchedules/{scheduleId} {
      allow read: if isAdmin() || 
        (isSignedIn() && resource.data.clienteId == request.auth.uid); // Admin or payment schedule owner can read
      allow create: if isAdmin(); // Only admin can create payment schedules
      allow update: if isAdmin(); // Only admin can update payment schedules (mark payments as received)
      allow delete: if isAdmin(); // Only admin can delete payment schedules
    }
    
    // ====== CONSULTATION SYSTEM RULES (November 2025) ======
    
    // Consultation Templates - Admin manages templates, public can view active templates for booking
    match /consultationTemplates/{templateId} {
      allow read: if true; // Public read access for clients booking consultations
      allow create: if isAdmin(); // Only admin can create consultation templates
      allow update: if isAdmin(); // Only admin can update consultation templates
      allow delete: if isAdmin(); // Only admin can delete consultation templates
    }
    
    // Consultations - Public can create booking requests, admin manages approval workflow
    match /consultations/{consultationId} {
      allow read: if isAdmin(); // Only admin can view consultation requests (contains client PII)
      allow create: if true; // Public can create consultation booking requests via public form
      allow update: if isAdmin(); // Only admin can update consultations (approve, reject, convert to job)
      allow delete: if isAdmin(); // Only admin can delete consultations
    }
  }
}