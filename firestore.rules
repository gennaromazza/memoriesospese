rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        (request.auth.token.email == 'gennaro.mazzacane@gmail.com' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }
    
    // Subscriptions collection
    match /subscriptions/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Only server-side via webhook
    }
    
    // Galleries collection
    match /galleries/{galleryId} {
      allow read: if true; // Public read for gallery access
      allow create: if isSignedIn();
      allow update: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || isAdmin());
        
      // Gallery subcollections (legacy support)  
      match /photos/{photoId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && 
          (resource.data.uploaderEmail == request.auth.token.email || 
           resource.data.uploaderUid == request.auth.uid || isAdmin());
      }
      
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && 
          (resource.data.userId == request.auth.uid || isAdmin());
      }
      
      match /voice-memos/{memoId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && 
          (resource.data.userId == request.auth.uid || isAdmin());
      }
    }
    
    // Global photos collection
    match /photos/{photoId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && 
        (resource.data.uploaderEmail == request.auth.token.email || isAdmin());
      allow delete: if isSignedIn() && 
        (resource.data.uploaderEmail == request.auth.token.email || isAdmin());
    }
    
    // Comments collection
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Voice memos collection
    match /voice-memos/{memoId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Likes collection
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // Email notifications collection
    match /email-notifications/{notificationId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && 
        request.resource.data.keys().hasAll(['email', 'galleryId']) &&
        request.resource.data.email is string &&
        request.resource.data.galleryId is string;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Gallery access collection
    match /gallery-access/{accessId} {
      allow read: if isAdmin();
      allow create: if true; // Public can request access
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Studio settings
    match /studio-settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ====== QUESTIONARIO SYSTEM RULES ======
    
    // FAQ Sets - Admin only
    match /faqSets/{faqSetId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Questionnaire Tokens - Server-side only (no client access)
    match /questionnaireTokens/{tokenId} {
      allow read, write: if false; // Only via Cloud Functions
    }
    
    // Helper function for role validation
    function isValidRole(role) {
      return role == 'bride' || role == 'groom';
    }
    
    // Helper function for questionnaire token validation
    function hasValidQuestionnaireRole(galleryId, role) {
      // This will be validated via Cloud Function in production
      // For now, allow if role is valid
      return isValidRole(role);
    }
    
    // Gallery questionnaires
    match /galleries/{galleryId} {
      match /questionnaires/{questionnaireId} {
        // Admin can read/write everything
        allow read, write: if isAdmin();
        
        // Public read for questionnaire structure (limited fields)
        allow read: if request.auth != null && 
          hasValidQuestionnaireRole(galleryId, request.auth.token.role);
        
        // Questionnaire answers by role
        match /answers/{role} {
          // Admin full access
          allow read, write: if isAdmin();
          
          // Role-specific access (bride can only access bride answers, etc.)
          allow read, write: if isSignedIn() && 
            isValidRole(role) &&
            request.auth.token.role == role &&
            hasValidQuestionnaireRole(galleryId, role);
        }
        
        // Answer drafts by role
        match /drafts/{role} {
          // Admin full access
          allow read, write: if isAdmin();
          
          // Role-specific access for drafts
          allow read, write: if isSignedIn() && 
            isValidRole(role) &&
            request.auth.token.role == role &&
            hasValidQuestionnaireRole(galleryId, role);
        }
      }
    }
    
    // Public access to active FAQ questions (read-only, minimal data)
    match /faqSets/{faqSetId} {
      // Allow public read of active FAQ set questions only
      allow read: if resource.data.active == true && 
        request.auth != null &&
        // Limit to questions field only
        request.query.select == ['questions'];
    }
  }
}