rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
        (request.auth.token.email == 'gennaro.mazzacane@gmail.com' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Subscriptions collection - Email notifications for new photos
    match /subscriptions/{subscriptionId} {
      allow read: if true; // Lettura pubblica necessaria per server Express (invio notifiche email)
      allow create: if 
        // Permetti iscrizione con autenticazione (anche anonima) e validazione campi richiesti
        isSignedIn() &&
        request.resource.data.keys().hasAll(['galleryId', 'galleryName', 'email', 'active', 'subscribedAt']) &&
        request.resource.data.email is string &&
        request.resource.data.email.matches('.*@.*') && // Validazione email base
        request.resource.data.galleryId is string &&
        request.resource.data.galleryName is string &&
        request.resource.data.active == true &&
        request.resource.data.subscribedAt is timestamp;
      allow update: if isAdmin(); // Solo admin può modificare
      allow delete: if isAdmin(); // Solo admin può eliminare
    }

    // Galleries collection
    match /galleries/{galleryId} {
      allow read: if true; // Public read for gallery access
      allow create: if isSignedIn();
      allow update: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || isAdmin());

      // Gallery subcollections (legacy support)  
      match /photos/{photoId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && 
          (resource.data.uploaderEmail == request.auth.token.email || 
           resource.data.uploaderUid == request.auth.uid || isAdmin());
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && 
          (resource.data.userId == request.auth.uid || isAdmin());
      }

      match /voiceMemos/{memoId} {
        allow read: if true;
        allow create: if true; // Allow anonymous voice memo creation
        allow update, delete: if isSignedIn() && 
          (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // Global photos collection
    match /photos/{photoId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && 
        (resource.data.uploaderEmail == request.auth.token.email || isAdmin());
      allow delete: if isSignedIn() && 
        (resource.data.uploaderEmail == request.auth.token.email || isAdmin());
    }

    // Comments collection
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Voice memos collection (global)
    match /voiceMemos/{memoId} {
      allow read: if true;
      allow create: if true; // Allow anonymous voice memo creation
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Likes collection
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Email notifications collection
    match /email-notifications/{notificationId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && 
        request.resource.data.keys().hasAll(['email', 'galleryId']) &&
        request.resource.data.email is string &&
        request.resource.data.galleryId is string;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Gallery access collection
    match /gallery-access/{accessId} {
      allow read: if isAdmin();
      allow create: if true; // Public can request access
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Password requests collection - Richieste password pubbliche
    match /passwordRequests/{requestId} {
      allow read: if isAdmin();
      allow create: if true; // Chiunque può richiedere la password
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Studio settings (legacy)
    match /studio-settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings collection (new structure)
    match /settings/{documentId} {
      allow read: if true; // Ospiti possono leggere le informazioni dello studio
      allow write: if isAdmin(); // Solo admin può modificare le impostazioni
    }

    // ====== QUESTIONARIO SYSTEM RULES ======

    // FAQ Sets - Con regole per inizializzazione automatica
    match /faqSets/{faqSetId} {
      allow read: if true; // Lettura pubblica per disponibilità set
      allow write: if isAdmin();
      allow create: if isAdmin() || 
        (request.resource.data.createdBy == 'system' && 
         request.resource.data.version == 1); // Permetti creazione set sistema v1
    }

    // Questionnaire Tokens - Permetti lettura pubblica per validazione, admin per gestione
    match /questionnaireTokens/{tokenId} {
      allow read: if true; // Lettura pubblica per validazione token
      allow write: if isAdmin(); // Solo admin può creare/modificare/eliminare token
    }

    // ===== Validation Sessions =====
    match /validationSessions/{sessionId} {
      allow read: if true;
      allow create: if true;
      allow update: if true; // Permetti aggiornamento per usedAt
      allow delete: if isAdmin();
    }

    // Rate Limits - Permetti accesso pubblico per controllo rate limiting
    match /rateLimits/{identifier} {
      allow read: if true; // Lettura pubblica per verifica rate limits
      allow create, update: if true; // Creazione/aggiornamento pubblico per conteggi
      allow delete: if isAdmin(); // Solo admin può eliminare rate limits
    }

    // Distributed Locks - Per prevenire race conditions nelle operazioni atomiche
    match /distributedLocks/{lockId} {
      allow read: if true; // Lettura pubblica per verifica lock esistenti
      allow create, update: if true; // Creazione/aggiornamento pubblico per acquisizione lock
      allow delete: if true; // Eliminazione pubblica per rilascio lock e cleanup
    }

    // Helper function for role validation
    function isValidRole(role) {
      return role == 'bride' || role == 'groom';
    }

    // Helper function for questionnaire token validation
    function hasValidToken(galleryId, role, token) {
      // This will be validated via Cloud Function in production
      // For now, allow if token is present and role is valid
      return true; // Placeholder, replace with actual token validation logic
    }

    // ===== Questionnaires =====
    match /galleries/{galleryId}/questionnaires/{questionnaireId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();

      // Risposte definitive
      match /answers/{role} {
        allow read: if true; // Permetti lettura libera per debugging
        allow write: if
          isValidRole(role) &&
          (isAdmin() || 
           (request.query.token != null && hasValidToken(galleryId, role, request.query.token)));
      }

      // Bozze risposte
      match /drafts/{role} {
        allow read: if true; // Permetti lettura libera per debugging  
        allow write: if
          isValidRole(role) &&
          (isAdmin() ||
           (request.query.token != null && hasValidToken(galleryId, role, request.query.token)));
      }
    }

    // Public access to active FAQ questions (read-only, minimal data)
    match /faqSets/{faqSetId} {
      // Allow public read of active FAQ set questions only
      allow read: if resource.data.active == true && 
        request.auth != null &&
        // Limit to questions field only
        request.query.select == ['questions'];
    }

    // ====== COUPLE STORIES SYSTEM RULES ======
    
    // Couple Stories collection - Admin only creation/modification, public read access for gallery viewing
    match /coupleStories/{galleryId} {
      allow read: if true; // Public read access for story viewing in galleries
      allow create: if isAdmin(); // Only admin can create new stories
      allow update: if isAdmin(); // Only admin can update existing stories
      allow delete: if isAdmin(); // Only admin can delete stories
    }

    // ====== SLIDESHOW IMAGES RULES ======
    
    // Slideshow images collection - Admin only management, public read access
    match /slideshow/{imageId} {
      allow read: if true; // Public read access for homepage slideshow
      allow create: if isAdmin(); // Only admin can add slideshow images
      allow update: if isAdmin(); // Only admin can update slideshow images
      allow delete: if isAdmin(); // Only admin can delete slideshow images
    }
  }
}