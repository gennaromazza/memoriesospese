rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        (request.auth.token.email == 'gennaro.mazzacane@gmail.com' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }
    
    // Subscriptions collection
    match /subscriptions/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Only server-side via webhook
    }
    
    // Galleries collection
    match /galleries/{galleryId} {
      allow read: if true; // Public read for gallery access
      allow create: if isSignedIn();
      allow update: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || isAdmin());
        
      // Gallery subcollections (legacy support)
      match /photos/{photoId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
      
      match /comments/{commentId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
      
      match /voice-memos/{memoId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }
    
    // Global photos collection
    match /photos/{photoId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && 
        (resource.data.uploaderEmail == request.auth.token.email || isAdmin());
      allow delete: if isSignedIn() && 
        (resource.data.uploaderEmail == request.auth.token.email || isAdmin());
    }
    
    // Comments collection
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Voice memos collection
    match /voice-memos/{memoId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && 
        (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Likes collection
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // Email notifications collection
    match /email-notifications/{notificationId} {
      allow read: if isAdmin();
      allow create: if true; // Allow public to subscribe
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Gallery access collection
    match /gallery-access/{accessId} {
      allow read: if isAdmin();
      allow create: if true; // Public can request access
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Studio settings
    match /studio-settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}