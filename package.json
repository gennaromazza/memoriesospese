{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:date-selectors": "playwright test --config artifacts/image-studio-web/playwright.date-selectors.config.ts",
    "test:photobook-client": "playwright test --config artifacts/image-studio-web/playwright.photobook-client.config.ts",
    "test:collaborator-products": "playwright test --config artifacts/image-studio-web/playwright.collaborator-products.config.ts",
    "test:quick-quote-preview": "playwright test --config artifacts/image-studio-web/playwright.quick-quote-preview.config.ts",
    "test:admin-passkey": "playwright test --config artifacts/image-studio-web/playwright.admin-passkey.config.ts",
    "test:admin-react": "playwright test --config artifacts/image-studio-web/playwright.admin-passkey.config.ts --grep \"admin dashboard React smoke\"",
    "test:desktop-gallery-jobs": "playwright test --config artifacts/image-studio-desktop/tests/job-flow/playwright.config.ts"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
