{
  "name": "wedding-gallery-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for Wedding Gallery email system",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^4.9.0",
    "googleapis": "^164.0.0",
    "nodemailer": "^6.9.8",
    "papaparse": "^5.4.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/cors": "^2.8.17",
    "@types/nodemailer": "^6.4.14",
    "@types/papaparse": "^5.3.14",
    "typescript": "^5.3.3"
  }
}
